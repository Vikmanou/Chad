Map(f, r) vs Nil        => f ~ Ghost, r ~ Nil
Map(f, r) vs Cons[x](s) => f ~ Rep(f1, f2), f1 ~ Chad(x, y), y ~ Link(r, rest), s ~ Map(f2, rest)
Link(r, rest) vs n      => r ~ Cons[n](rest)

Double(r) vs n => r ~ n * 2

ShowAll(w, next) vs Nil         => next ~ w
ShowAll(w, next) vs Cons[x](s)  => Say['0' + x](w2) ~ w, s ~ ShowMore(w2, next)
ShowMore(w, next) vs Nil        => next ~ w
ShowMore(w, next) vs Cons[x](s) => Say[' '](Say['0' + x](w2)) ~ w, s ~ ShowMore(w2, next)

main
  Cons[1](Cons[2](Cons[3](Nil))) ~ Map(Chad(Double(r), r), doubled)
  doubled ~ ShowAll(world, Ghost)