ngl `out` gets the next number in the input, or Silence
HearNum(w, next, out) vs Silence => next ~ w, out ~ Silence
HearNum(w, next, out) vs c
  if c >= '0' and c <= '9' => Hear(w2, Acc[c - '0', 1](w2, next, out)) ~ w
  if c == '-'              => Hear(w2, Minus(w2, next, out)) ~ w
  else                     => Hear(w2, HearNum(w2, next, out)) ~ w
Minus(w, next, out) vs Silence => next ~ w, out ~ Silence
Minus(w, next, out) vs c
  if c >= '0' and c <= '9' => Hear(w2, Acc[c - '0', -1](w2, next, out)) ~ w
  else                     => c ~ HearNum(w, next, out)
Acc[a, sign](w, next, out) vs Silence => next ~ w, out ~ a * sign
Acc[a, sign](w, next, out) vs c
  if c >= '0' and c <= '9' => Hear(w2, Acc[a * 10 + c - '0', sign](w2, next, out)) ~ w
  else                     => next ~ w, out ~ a * sign

Ask(w, next, out) vs Nil        => Hear(w2, HearNum(w2, next, out)) ~ w
Ask(w, next, out) vs Cons[c](s) => Say[c](w2) ~ w, s ~ Ask(w2, next, out)