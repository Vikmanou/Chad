ngl `out` gets the next number in the input, or Eof
Num(w, next, out) vs Eof => next ~ w, out ~ Eof
Num(w, next, out) vs c
  if c >= '0' and c <= '9' => Read(w2, Acc[c - '0', 1](w2, next, out)) ~ w
  if c == '-'              => Read(w2, Minus(w2, next, out)) ~ w
  else                     => Read(w2, Num(w2, next, out)) ~ w
Minus(w, next, out) vs Eof => next ~ w, out ~ Eof
Minus(w, next, out) vs c
  if c >= '0' and c <= '9' => Read(w2, Acc[c - '0', -1](w2, next, out)) ~ w
  else                     => c ~ Num(w, next, out)
Acc[a, sign](w, next, out) vs Eof => next ~ w, out ~ a * sign
Acc[a, sign](w, next, out) vs c
  if c >= '0' and c <= '9' => Read(w2, Acc[a * 10 + c - '0', sign](w2, next, out)) ~ w
  else                     => next ~ w, out ~ a * sign

Ask(w, next, out) vs Nil        => Read(w2, Num(w2, next, out)) ~ w
Ask(w, next, out) vs Cons[c](s) => Say[c](w2) ~ w, s ~ Ask(w2, next, out)